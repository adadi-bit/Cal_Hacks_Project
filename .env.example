# Copy to .env and fill in. Never commit .env. Every key is optional: Ember routes, prints and speaks without any of them.

# Claude (vision pass, plan writer, actor 1 extraction, navigator voice agent)
ANTHROPIC_API_KEY=
EMBER_CLAUDE_MODEL=claude-sonnet-4-6

# Cartesia (pre-generated clips, streaming TTS, voice cloning)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Apify (actor runs and dataset reads)
APIFY_TOKEN=
APIFY_SITUATION_DATASET_ID=
APIFY_EVIDENCE_DATASET_ID=

# Satellite thumbnails (zoom 18, 640x640) — one of these
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=

# Staff tool
EMBER_PASSPHRASE=change-me
EMBER_COUNTY=fake
EMBER_ALERT_LINE=Sign up for county emergency alerts before fire season.
# EMBER_ENGINE_URL=http://127.0.0.1:8765   # use engine/serve.py instead of the in-process engine
